{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommitType(chore)",
    ":semanticCommitScope(deps)",
    ":label(dependencies)",
    ":enablePreCommit",
    ":automergePr",
    "helpers:pinGitHubActionDigests",
    "schedule:weekends",
    "schedule:automergeEarlyMondays",
  ],

  branchPrefix: "chore/deps/",
  commitMessageAction: "update",
  minimumReleaseAge: "3 days",
  // Keep version ranges; bump uv.lock to the newest in-range version.
  rangeStrategy: "update-lockfile",

  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      automerge: true,
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },

    {
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      matchPackageNames: ["ruff", "ty"],
      groupName: "linters",
    },
    {
      matchPackageNames: ["commitizen", "pre-commit"],
      groupName: "commit tooling",
    },
    {
      matchPackageNames: ["pytest", "pytest-*", "callee"],
      groupName: "testing",
    },
  ],
}
